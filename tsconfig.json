{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/**/*.d.ts", "packages/**/*.ts", "games/autonomous-snake/src/**/*.ts", "games/ai-maze-escape/src/**/*.ts", "services/**/*.ts"]
}
