[{"path":"public/tiny-kingdom/index.html","start":1819,"end":1820,"text":"requestAnimationFrame(render);window.__tinyKingdom={getState:()=>JSON.parse(JSON.stringify({state,people:people.map(({name,job,x,z,target})=>({name,job,x,z,target}))})),setSpeed:x=>{speed=x},step,reset:start,renderer:()=>canvas.getContext('webgl')?'webgl':'software',metrics:()=>({citizens:people.length,buildings:city.length+2,day:Math.floor(state.t/24)+1,food:state.food,wood:state.wood,gold:state.gold,relationships:people.filter(p=>p.friend).length}),route:(a,b)=>routeBetween(a[0],a[1],b[0],b[1]),walkable:(p)=>walkable(p[0],p[1]),getNavigation:()=>people.map(p=>({name:p.name,position:[p.x,p.z],target:p.target,remaining:p.path?.length||0,path:p.path,activity:p.activity,hunger:p.hunger,energy:p.energy})),exportSnapshot,restoreSnapshot,saveWorld,restoreWorld,climateAt,skyConditions,getCitizenProfiles:()=>cloneData(people.map(({name,job,trait,friend,bonds,energy,hunger,activity})=>({name,job,trait,friend,bonds,energy,hunger,activity}))),getRigPose:(index=0)=>Number.isInteger(index)&&index>=0&&index<people.length?cloneData(citizenRigPose(people[index])):null,getGarmentProfile:(index=0)=>Number.isInteger(index)&&index>=0&&index<people.length?cloneData(garmentProfile(people[index],index,citizenRigPose(people[index]))):null,getFaceProfile:(index=0)=>Number.isInteger(index)&&index>=0&&index<people.length?cloneData(faceProfile(people[index],index)):null,getSelectedCitizen:()=>people[selectedCitizen]?.name,routeCacheMetrics:()=>({entries:routeCache.size,hits:cacheHits,misses:cacheMisses}),getCamera:()=>({yaw,pitch,zoom,focus:focusPoint.slice(),follow,cinematic}),getTerrainHeight:(x,z)=>terrain(x,z),getWildfloraCount:()=>wildflora.length,getMeadowStats:()=>({clusters:meadowUnderstory.length,triangles:meadowUnderstory.length*8,season:climateAt(state.t).season,cached:true}),getMaterialSystem:()=>({vertexStride:10,surfaceShaderVersion:'linear-shadow-043',materials:Object.keys(MATERIAL),gpuRenderValidated:false}),waterStats:()=>({model:'fresnel-ripple-shorefoam-v1',segments:RIVER_SEGMENTS,waterTriangles:RIVER_SEGMENTS*RIVER_BANDS*2,bankTriangles:RIVER_SEGMENTS*2*RIVER_BANK_BANDS*2}),getScenicSites:scenicSiteMetrics,getFestivalVisualStats:()=>({season:festivalSeason,cacheBuilds:festivalCacheBuilds,vertices:festivalGeometry?.length||0}),getGeometryAudit:geometryAudit,getCraftDistrictStats:()=>({...CRAFT_DISTRICT,...craftCounters}),getCottageEffects:()=>({activeChimneys,smokePuffs,smokeTriangles,smokeMaxRadius}),renderStats:()=>({terrainRebuilds,terrainCacheKey,terrainCacheTriangles,lastFrameTriangles,scenicMeshRebuilds,scenicMeshTriangles,scenicMeshKey,staticGpuUploads,dualBufferGPU:gpuAvailable}),getFoliageStats:foliageStats,getLivingPresentationStats:livingPresentationStats,inspectCitizen,getCitizenInspection:citizenInspection,getPresentationStats:presentationStats,setInspector,setGraphicsPreset,getDistrictStats:()=>({...districtStats}),getLightingStats:lightingStats,renderQuality,setRenderQuality,shadowStats:()=>({triangles:castShadowTriangles,...sunShadow(state.t)}),sampleSunShadow:(time)=>sunShadow(time),getEconomyHistory:()=>cloneData(uiHistory),getHudMode:()=>cinematicHud?'cinema':'full',setHudMode:setCinematicHud,getCommandView:()=>commandView,setCommandView,skyStats:()=>({enabled:gpuAvailable,passes:skyPassCount,model:'day-night-atmosphere-v1'}),setCamera:o=>{exitCitizenInspection();yaw=Number.isFinite(o.yaw)?o.yaw:yaw;pitch=Number.isFinite(o.pitch)?Math.max(.25,Math.min(1.45,o.pitch)):pitch;zoom=Number.isFinite(o.zoom)?Math.max(9,Math.min(85,o.zoom)):zoom;if(Array.isArray(o.focus)&&o.focus.length===2)focusPoint=o.focus.slice(0,2)}};\n"},{"path":"tests/tiny-kingdom/browser-harness.cjs","start":5,"end":7,"text":"function markup(source) {\n let html = source || fs.readFileSync(path.join(root, 'public/tiny-kingdom/index.html'), 'utf8');\n"},{"path":"tests/tiny-kingdom/browser-harness.cjs","start":12,"end":12,"text":" captureFace:()=>{const old=data;try{data=[];sculptedFace(0,0,0,1,[.7,.5,.4],[.2,.15,.1],faceProfile(people[0],0));return data.slice()}finally{data=old}},\n"},{"path":"tests/tiny-kingdom/browser-harness.cjs","start":25,"end":26,"text":"async function open(browser,viewport={width:1280,height:720},source) {\n"},{"path":"tests/tiny-kingdom/browser-harness.cjs","start":27,"end":28,"text":" page.on('pageerror',error=>errors.push(error.message));await page.setContent(markup(source));\n"},{"path":"scripts/serve-tiny-kingdom-stream.cjs","start":15,"end":15,"text":" ['/tiny/living','living.html'],['/tiny/living.html','living.html'],\n ...['baseline-village.png','baseline-woodland.png','baseline-manifest.json','living-village.png','living-woodland.png',\n 'living-citizen-0.png','living-citizen-1.png','living-citizen-2.png','living-citizen-3.png','living-citizen-4.png','living-citizen-5.png',\n 'living-mobile.png','living-night.png','living-live.webm','living-manifest.json','living-verification.json'].map(name=>['/tiny/'+name,name]),\n"},{"path":"tests/tiny-kingdom/hd-server.test.cjs","start":7,"end":7,"text":"test('living journal has hashed content policy and refuses unlisted or traversing evidence names',async()=>{\n const server=createServer();await new Promise(r=>server.listen(0,'127.0.0.1',r));\n try{const origin='http://127.0.0.1:'+server.address().port;const response=await fetch(origin+'/tiny/living');assert.equal(response.status,200);const html=await response.text(),csp=response.headers.get('content-security-policy');assert.match(html,/Pagonia benchmark: NOT PASSED/);assert.ok(csp.includes(\"connect-src 'self'\"));assert.ok(csp.includes(\"media-src 'self'\"));assert.ok(csp.includes('sha256-'));assert.ok(!csp.includes('unsafe-inline'));for(const name of ['living-private.json','living-../../package.json','%2e%2e%2fpackage.json'])assert.equal((await fetch(origin+'/tiny/'+name)).status,404)}finally{await new Promise(r=>server.close(r))}\n});\n"}]
