{
  "name": "ai-games",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/foundation/*.test.cjs tests/phase2/*.test.cjs tests/phase3/*.test.cjs tests/phase4/*.test.cjs tests/phase5/*.test.cjs tests/phase6/*.test.cjs",
    "test:phase3": "npm run build && node --test tests/phase3/*.test.cjs",
    "test:phase4": "npm run build && node --test tests/phase4/*.test.cjs",
    "test:phase5": "npm run build && node --test tests/phase5/*.test.cjs",
    "test:phase6": "npm run build && node --test tests/phase6/*.test.cjs",
    "test:maze:phase1": "npm run build && node --test tests/foundation/maze-*.test.cjs",
    "test:maze:phase2": "npm run build && node --test tests/phase2/maze-*.test.cjs",
    "test:maze:phase3": "npm run build && node --test tests/phase3/maze-*.test.cjs",
    "test:maze:phase4": "npm run build && node --test tests/phase4/maze-*.test.cjs",
    "test:maze:phase5": "npm run build && node --test tests/phase5/maze-*.test.cjs",
    "test:maze:phase6": "npm run build && node --test tests/phase6/maze-*.test.cjs",
    "test:ant:phase1": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs",
    "test:ant:phase2": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs tests/phase2/ant-colony-*.test.cjs",
    "test:ant:phase3": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs tests/phase2/ant-colony-*.test.cjs tests/phase3/ant-colony-*.test.cjs",
    "test:ant:phase4": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs tests/phase2/ant-colony-*.test.cjs tests/phase3/ant-colony-*.test.cjs tests/phase4/ant-colony-*.test.cjs",
    "test:ant:phase5": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs tests/phase2/ant-colony-*.test.cjs tests/phase3/ant-colony-*.test.cjs tests/phase4/ant-colony-*.test.cjs tests/phase5/ant-colony-*.test.cjs",
    "test:ant:phase6": "npm run build && node --test tests/foundation/ant-colony-*.test.cjs tests/phase2/ant-colony-*.test.cjs tests/phase3/ant-colony-*.test.cjs tests/phase4/ant-colony-*.test.cjs tests/phase5/ant-colony-*.test.cjs tests/phase6/ant-colony-*.test.cjs",
    "test:tower:phase1": "npm run build && node --test tests/foundation/tower-*.test.cjs",
    "test:tower:phase2": "npm run build && node --test tests/phase2/tower-*.test.cjs",
    "test:tower:phase3": "npm run build && node --test tests/phase3/tower-*.test.cjs",
    "test:tower:phase4": "npm run build && node --test tests/phase4/tower-*.test.cjs",
    "test:tower:phase5": "npm run build && node --test tests/phase5/tower-*.test.cjs",
    "test:tower:phase6": "npm run build && node --test tests/phase6/tower-*.test.cjs",
    "test:battle:phase3": "npm run build && node --test tests/phase3/battle-*.test.cjs",
    "test:battle:phase4": "npm run build && node --test tests/phase4/battle-*.test.cjs",
    "test:battle:phase5": "npm run build && node --test tests/phase5/battle-*.test.cjs",
    "test:battle:phase6": "npm run build && node --test tests/phase6/battle-*.test.cjs",
    "test:browser": "playwright test",
    "snake:headless": "npm run build && node scripts/run-snake-headless.cjs",
    "snake:stream": "npm run build && node scripts/serve-snake-stream.cjs",
    "snake:stream:self-test": "npm run build && node scripts/serve-snake-stream.cjs --self-test",
    "snake:phase5:chaos": "npm run build && node scripts/run-phase5-chaos.cjs",
    "snake:phase6:validate": "npm run build && node scripts/run-phase6-validation.cjs",
    "maze:headless": "npm run build && node scripts/run-maze-headless.cjs",
    "maze:campaign": "npm run build && node scripts/run-maze-campaign.cjs",
    "maze:stream": "npm run build && node scripts/serve-maze-stream.cjs",
    "maze:stream:self-test": "npm run build && node scripts/serve-maze-stream.cjs --self-test",
    "maze:phase5:chaos": "npm run build && node scripts/run-maze-phase5-chaos.cjs",
    "maze:phase6:validate": "npm run build && node scripts/run-maze-phase6-validation.cjs",
    "ant:headless": "npm run build && node scripts/run-ant-colony-headless.cjs",
    "ant:campaign": "npm run build && node scripts/run-ant-colony-campaign.cjs",
    "ant:stream": "npm run build && node scripts/serve-ant-colony-stream.cjs",
    "ant:stream:self-test": "npm run build && node scripts/serve-ant-colony-stream.cjs --self-test",
    "ant:phase5:chaos": "npm run build && node scripts/run-ant-colony-phase5-chaos.cjs",
    "ant:phase6:validate": "npm run build && node scripts/run-ant-colony-phase6-validation.cjs",
    "tower:headless": "npm run build && node scripts/run-tower-headless.cjs",
    "tower:stream": "npm run build && node scripts/serve-tower-stream.cjs",
    "tower:stream:self-test": "npm run build && node scripts/serve-tower-stream.cjs --self-test",
    "tower:phase5:chaos": "npm run build && node scripts/run-tower-phase5-chaos.cjs",
    "tower:phase6:validate": "npm run build && node scripts/run-tower-phase6-validation.cjs",
    "battle:stream": "npm run build && node scripts/serve-battle-royale-stream.cjs",
    "battle:stream:self-test": "npm run build && node scripts/serve-battle-royale-stream.cjs --self-test",
    "battle:phase5:chaos": "npm run build && node scripts/run-battle-royale-chaos.cjs",
    "battle:phase6:validate": "npm run build && node scripts/run-battle-royale-phase6-validation.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "typescript": "5.8.3"
  }
}
