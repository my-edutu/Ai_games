{
  "name": "ai-games",
  "version": "0.7.0",
  "private": true,
  "engines": {"node": ">=22.0.0"},
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/foundation/*.test.cjs tests/phase2/*.test.cjs tests/phase3/*.test.cjs tests/phase4/*.test.cjs tests/phase5/*.test.cjs tests/phase6/*.test.cjs tests/escape-room/*.test.cjs",
    "test:phase3": "npm run build && node --test tests/phase3/*.test.cjs",
    "test:phase4": "npm run build && node --test tests/phase4/*.test.cjs",
    "test:phase5": "npm run build && node --test tests/phase5/*.test.cjs",
    "test:phase6": "npm run build && node --test tests/phase6/*.test.cjs",
    "test:maze:phase1": "npm run build && node --test tests/foundation/maze-*.test.cjs",
    "test:maze:phase2": "npm run build && node --test tests/phase2/maze-*.test.cjs",
    "test:maze:phase3": "npm run build && node --test tests/phase3/maze-*.test.cjs",
    "test:maze:phase4": "npm run build && node --test tests/phase4/maze-*.test.cjs",
    "test:maze:phase5": "npm run build && node --test tests/phase5/maze-*.test.cjs",
    "test:maze:phase6": "npm run build && node --test tests/phase6/maze-*.test.cjs",
    "test:escape:phase1": "npm run build && node --test tests/escape-room/phase1-*.test.cjs",
    "test:escape:phase2": "npm run build && node --test tests/escape-room/phase2-*.test.cjs",
    "test:escape:phase3": "npm run build && node --test tests/escape-room/phase3-*.test.cjs",
    "test:browser": "playwright test",
    "test:browser:escape-room": "playwright test tests/browser/escape-room-stream.spec.cjs",
    "snake:headless": "npm run build && node scripts/run-snake-headless.cjs",
    "snake:stream": "npm run build && node scripts/serve-snake-stream.cjs",
    "snake:stream:self-test": "npm run build && node scripts/serve-snake-stream.cjs --self-test",
    "snake:phase5:chaos": "npm run build && node scripts/run-phase5-chaos.cjs",
    "snake:phase6:validate": "npm run build && node scripts/run-phase6-validation.cjs",
    "maze:headless": "npm run build && node scripts/run-maze-headless.cjs",
    "maze:campaign": "npm run build && node scripts/run-maze-campaign.cjs",
    "maze:stream": "npm run build && node scripts/serve-maze-stream.cjs",
    "maze:stream:self-test": "npm run build && node scripts/serve-maze-stream.cjs --self-test",
    "maze:phase5:chaos": "npm run build && node scripts/run-maze-phase5-chaos.cjs",
    "maze:phase6:validate": "npm run build && node scripts/run-maze-phase6-validation.cjs",
    "escape-room:headless": "npm run build && node scripts/run-escape-room-headless.cjs",
    "escape-room:campaign": "npm run build && node scripts/run-escape-room-campaign.cjs",
    "escape-room:stream": "npm run build && node scripts/serve-escape-room-stream.cjs",
    "escape-room:stream:self-test": "npm run build && node scripts/serve-escape-room-stream.cjs --self-test"
  },
  "devDependencies": {"@playwright/test": "1.55.0", "typescript": "5.8.3"}
}
